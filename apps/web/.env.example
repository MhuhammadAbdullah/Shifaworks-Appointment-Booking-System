# Browser-visible configuration only. NEVER put the Supabase service-role key,
# database URLs, email credentials or any other secret in this app.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<publishable-or-anon-key>
NEXT_PUBLIC_DEFAULT_TIMEZONE=Asia/Karachi
# The WordPress site: the bare booking domain redirects here (no service listing in this app).
NEXT_PUBLIC_WEBSITE_URL=https://shifaworks.com
