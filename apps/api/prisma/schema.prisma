// =============================================================================
// ShifaWorks booking & management — database schema
//
// Conventions
//  * All primary keys are UUID v4 (generated by Prisma Client on insert;
//    raw SQL inserts must supply gen_random_uuid() themselves).
//  * All instants are stored as timestamptz in UTC. Wall-clock data that must
//    stay "local" (weekly working hours) is stored as minutes-from-midnight
//    together with an IANA timezone (default Asia/Karachi).
//  * Money is Decimal(12,2); currency is an ISO-4217 code (default PKR).
//  * Table names are snake_case plurals (@@map); column names are camelCase.
//  * Constraints Prisma cannot express (exclusion constraints, CHECKs, RLS)
//    live in prisma/migrations/*_constraints/migration.sql.
//  * Customers have NO login. Only staff and providers are users.
// =============================================================================

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum RecordStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DEACTIVATED
}

enum ProviderType {
  THERAPIST
  COUNSELLOR
}

enum Gender {
  MALE
  FEMALE
}

enum AvailabilityExceptionType {
  CUSTOM_HOURS // replaces weekly rules for the date(s) with the given intervals
  DAY_OFF
  LEAVE
  HOLIDAY
}

enum BookingType {
  APPOINTMENT
}

// Lifecycle shared by bookings and appointments.
// Slot-holding statuses (see the exclusion constraint): PENDING_PAYMENT,
// PAYMENT_SUBMITTED, PAYMENT_VERIFIED, CONFIRMED.
enum BookingStatus {
  PENDING_PAYMENT
  PAYMENT_SUBMITTED
  PAYMENT_VERIFIED
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
  RESCHEDULED
}

enum BookingSource {
  ONLINE
  ADMIN
  PHONE
  WALK_IN
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
  REFUNDED
}

enum PaymentMethod {
  BANK_TRANSFER
  JAZZCASH
  EASYPAISA
  CASH
  CARD
  OTHER
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

// CUSTOMER = a billing document for a customer/booking (existing). PROVIDER = a
// pay-slip for a therapist/counsellor's payout — same document machinery, own
// PDF branding, and (only for PROVIDER) posts an EXPENSE ledger row on issue.
enum InvoiceAudience {
  CUSTOMER
  PROVIDER
}

enum FinanceTransactionType {
  INCOME
  EXPENSE
  REFUND
  ADJUSTMENT
}

enum FinanceTransactionStatus {
  PENDING
  POSTED
  VOID
}

enum FinanceCategoryType {
  INCOME
  EXPENSE
}

enum ExpenseStatus {
  DRAFT
  APPROVED
  PAID
  REJECTED
}

// WHATSAPP is reserved for a future Meta Cloud API provider.
enum NotificationChannel {
  EMAIL
  WHATSAPP
}

enum NotificationAudience {
  CUSTOMER
  ADMIN
  PROVIDER
  STAFF // the specific staff/provider account a message is about (e.g. an invite) — not a booking participant
}

enum EmailTemplateKey {
  BOOKING_RECEIVED // customer + admin, right after submission
  BOOKING_CONFIRMED // customer + provider, after payment verification
  PAYMENT_REJECTED // customer
  BOOKING_CANCELLED // customer (+ provider if it was confirmed)
  BOOKING_RESCHEDULED // customer + provider
  STAFF_INVITE // staff/provider account invitation (or a set-password resend)
}

enum NotificationStatus {
  QUEUED
  SENDING
  SENT
  FAILED
  SKIPPED
}

enum DeliveryStatus {
  SENT
  DELIVERED
  FAILED
  BOUNCED
}

enum FileVisibility {
  PUBLIC
  PRIVATE
}

// -----------------------------------------------------------------------------
// Tenancy
// -----------------------------------------------------------------------------

model Organization {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  slug      String       @unique
  timezone  String       @default("Asia/Karachi")
  currency  String       @default("PKR") @db.Char(3)
  locale    String       @default("en-PK")
  email     String?
  phone     String?
  website   String?
  logoId    String?      @db.Uuid
  status    RecordStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)

  logo                File?                @relation("OrganizationLogo", fields: [logoId], references: [id], onDelete: SetNull)
  locations           Location[]
  users               User[]
  roles               Role[]
  staffProfiles       StaffProfile[]
  providerProfiles    ProviderProfile[]
  customers           Customer[]
  services            Service[]
  holidays            Holiday[]
  bookings            Booking[]
  appointments        Appointment[]
  payments            Payment[]
  invoices            Invoice[]
  financeCategories   FinanceCategory[]
  financeTransactions FinanceTransaction[]
  expenseCategories   ExpenseCategory[]
  expenses            Expense[]
  emailTemplates      EmailTemplate[]
  notifications       Notification[]
  files               File[]               @relation("OrganizationFiles")
  auditLogs           AuditLog[]
  settings            SystemSetting[]
  sequences           DocumentSequence[]

  @@map("organizations")
}

// Clinic branches / service locations (not the customer's own address).
model Location {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  slug           String
  timezone       String? // null => inherit organization timezone
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  postalCode     String?
  country        String?      @default("PK")
  phone          String?
  email          String?
  isDefault      Boolean      @default(false)
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staffProfiles     StaffProfile[]
  providerLocations ProviderLocation[]
  availabilities    Availability[]
  availabilityRules AvailabilityRule[]
  blockedSlots      BlockedSlot[]
  holidays          Holiday[]
  appointments      Appointment[]
  expenses          Expense[]
  userRoles         UserRole[]

  @@unique([organizationId, slug])
  @@index([organizationId, status])
  @@map("locations")
}

// -----------------------------------------------------------------------------
// Identity & access control (staff and providers only)
// -----------------------------------------------------------------------------

model User {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  authUserId     String?    @unique @db.Uuid // Supabase auth.users.id (null until the invite is accepted)
  email          String?    @unique
  phone          String?
  firstName      String
  lastName       String?
  avatarId       String?    @db.Uuid
  status         UserStatus @default(ACTIVE)
  locale         String?
  timezone       String?
  lastLoginAt    DateTime?  @db.Timestamptz(3)
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @db.Timestamptz(3)
  deletedAt      DateTime?  @db.Timestamptz(3)

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  avatar          File?            @relation("UserAvatar", fields: [avatarId], references: [id], onDelete: SetNull)
  userRoles       UserRole[]       @relation("UserRoleUser")
  grantedRoles    UserRole[]       @relation("UserRoleGrantedBy")
  userPermissions UserPermission[]
  staffProfile    StaffProfile?
  providerProfile ProviderProfile?

  // actor relations
  createdBookings       Booking[]            @relation("BookingCreatedBy")
  cancelledBookings     Booking[]            @relation("BookingCancelledBy")
  cancelledAppointments Appointment[]        @relation("AppointmentCancelledBy")
  checkedInAppointments Appointment[]        @relation("AppointmentCheckedInBy")
  notifications         Notification[]       @relation("NotificationUser")
  createdBlockedSlots   BlockedSlot[]
  verifiedPayments      Payment[]            @relation("PaymentVerifiedBy")
  rejectedPayments      Payment[]            @relation("PaymentRejectedBy")
  refundedPayments      Payment[]            @relation("PaymentRefundedBy")
  createdInvoices       Invoice[]            @relation("InvoiceCreatedBy")
  financeTransactions   FinanceTransaction[] @relation("FinanceTransactionCreatedBy")
  createdExpenses       Expense[]            @relation("ExpenseCreatedBy")
  approvedExpenses      Expense[]            @relation("ExpenseApprovedBy")
  uploadedFiles         File[]               @relation("FileUploadedBy")
  auditLogs             AuditLog[]
  updatedSettings       SystemSetting[]
  updatedTemplates      EmailTemplate[]

  @@index([organizationId, status])
  @@map("users")
}

model Role {
  id             String   @id @default(uuid()) @db.Uuid
  // null => system role shared by all organizations (SUPER_ADMIN, ADMIN, ...)
  organizationId String?  @db.Uuid
  key            String
  name           String
  description    String?
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization    Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([organizationId, key])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique // "bookings.view"
  module      String // "bookings"
  description String?
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  rolePermissions RolePermission[]
  userPermissions UserPermission[]

  @@index([module])
  @@map("permissions")
}

model RolePermission {
  roleId       String   @db.Uuid
  permissionId String   @db.Uuid
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId      String   @db.Uuid
  roleId      String   @db.Uuid
  locationId  String?  @db.Uuid // optional: role only applies at this location
  grantedById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  user      User      @relation("UserRoleUser", fields: [userId], references: [id], onDelete: Cascade)
  role      Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  location  Location? @relation(fields: [locationId], references: [id], onDelete: Cascade)
  grantedBy User?     @relation("UserRoleGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

// Per-user overrides on top of role permissions. granted=false is an explicit
// deny that wins over any role grant.
model UserPermission {
  userId       String   @db.Uuid
  permissionId String   @db.Uuid
  granted      Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@map("user_permissions")
}

// -----------------------------------------------------------------------------
// People
// -----------------------------------------------------------------------------

model StaffProfile {
  id                String       @id @default(uuid()) @db.Uuid
  userId            String       @unique @db.Uuid
  organizationId    String       @db.Uuid
  primaryLocationId String?      @db.Uuid
  employeeCode      String?
  department        String?
  jobTitle          String?
  joiningDate       DateTime?    @db.Date
  status            RecordStatus @default(ACTIVE)
  createdAt         DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime     @updatedAt @db.Timestamptz(3)

  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  primaryLocation Location?    @relation(fields: [primaryLocationId], references: [id], onDelete: SetNull)

  @@unique([organizationId, employeeCode])
  @@map("staff_profiles")
}

// Therapists and counsellors. A provider may exist before they have a login
// (userId null); inviting them links a User for the provider dashboard.
model ProviderProfile {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @db.Uuid
  userId          String?      @unique @db.Uuid
  providerType    ProviderType
  slug            String
  displayName     String // "HK. Hayyan Marfani"
  email           String? // where booking-confirmed emails go
  phone           String?
  gender          Gender
  designation     String? // "Hijama Therapist"
  bio             String?
  profileImageId  String?      @db.Uuid
  experienceYears Int          @default(0)
  rating          Decimal?     @db.Decimal(2, 1) // 0.0–5.0, set by admin
  specializations String[]
  acceptsMale     Boolean      @default(true)
  acceptsFemale   Boolean      @default(true)
  timezone        String? // null => organization timezone
  calendarColor   String?      @db.VarChar(9)
  isActive        Boolean      @default(true)
  sortOrder       Int          @default(0)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)
  // Set instead of a hard delete once the provider has appointments — appointmentId
  // is not nullable, so their bookings/payments/invoices must keep a real provider
  // row to point at. Every read excludes deletedAt rows; historical bookings still
  // resolve the provider fine via the relation, since the row itself is untouched.
  deletedAt       DateTime?    @db.Timestamptz(3)

  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                   User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  profileImage           File?                   @relation("ProviderImage", fields: [profileImageId], references: [id], onDelete: SetNull)
  locations              ProviderLocation[]
  services               ServiceProvider[]
  availabilities         Availability[]
  availabilityExceptions AvailabilityException[]
  blockedSlots           BlockedSlot[]
  appointments           Appointment[]
  payslips               Invoice[]

  @@unique([organizationId, slug])
  @@index([organizationId, providerType, isActive])
  @@map("provider_profiles")
}

model ProviderLocation {
  providerId String @db.Uuid
  locationId String @db.Uuid

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  location Location        @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([providerId, locationId])
  @@index([locationId])
  @@map("provider_locations")
}

// A person who booked (no account). Matched by email on each submission so
// staff can see someone's history; each booking also keeps its own snapshot
// of exactly what was submitted.
model Customer {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  customerNumber String // CUS-2026-000001
  firstName      String
  lastName       String?
  email          String? // lower-cased
  phone          String?
  dateOfBirth    DateTime? @db.Date
  gender         Gender?
  city           String?
  province       String?
  address        String?
  internalNotes  String? // staff only
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(3)

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookings            Booking[]
  appointments        Appointment[]
  payments            Payment[]
  invoices            Invoice[]
  financeTransactions FinanceTransaction[]

  @@unique([organizationId, customerNumber])
  @@index([organizationId, email])
  @@index([organizationId, phone])
  @@map("customers")
}

// -----------------------------------------------------------------------------
// Services (fixed set; each slug has a developer-defined booking form)
// -----------------------------------------------------------------------------

model Service {
  id                     String        @id @default(uuid()) @db.Uuid
  organizationId         String        @db.Uuid
  name                   String
  slug                   String // must match a form in packages/shared/src/service-forms
  description            String?
  // The booking form is shown only when isActive AND bookingEnabled.
  isActive               Boolean       @default(false)
  bookingEnabled         Boolean       @default(true)
  // Services with no "in person or online" question at all (e.g. Hijama Therapy) never show this field regardless.
  deliveryModeVisible    Boolean       @default(true)
  providerType           ProviderType? // restricts which providers can be assigned
  defaultDurationMinutes Int           @default(60)
  bufferBeforeMinutes    Int           @default(0)
  bufferAfterMinutes     Int           @default(0)
  slotIntervalMinutes    Int? // step between candidate starts; null => duration + bufferAfter
  minNoticeMinutes       Int           @default(120)
  maxAdvanceDays         Int           @default(60)
  currency               String        @default("PKR") @db.Char(3)
  sortOrder              Int           @default(0)
  createdAt              DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime      @updatedAt @db.Timestamptz(3)

  organization           Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  packages               ServicePackage[]
  providers              ServiceProvider[]
  appointments           Appointment[]
  invoiceItems           InvoiceItem[]
  concernOptions         ServiceConcernOption[]
  availabilityExceptions AvailabilityException[]

  @@unique([organizationId, slug])
  @@map("services")
}

// Admin-managed options for a service's "Areas of concern" style checklist
// (clinical/faith-based counseling, life coaching). `code` is the stable key
// stored in a booking's formData — never reuse a code after deleting it.
// "Other" is a fixed client-side choice, not a row here.
model ServiceConcernOption {
  id        String   @id @default(uuid()) @db.Uuid
  serviceId String   @db.Uuid
  code      String
  label     String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, code])
  @@index([serviceId, isActive, sortOrder])
  @@map("service_concern_options")
}

// Priced options of a service: Hijama packages, counselling session types.
model ServicePackage {
  id              String   @id @default(uuid()) @db.Uuid
  serviceId       String   @db.Uuid
  name            String // "Sciatic Support Package"
  description     String?
  points          Int? // Hijama cup points (15-point, 12-point)
  durationMinutes Int? // null => service default
  price           Decimal  @db.Decimal(12, 2)
  discountEnabled Boolean  @default(false)
  discountPercent Decimal? @db.Decimal(5, 2) // 0-100, only meaningful when discountEnabled
  isActive        Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  service      Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@index([serviceId, isActive, sortOrder])
  @@map("service_packages")
}

model ServiceProvider {
  serviceId  String  @db.Uuid
  providerId String  @db.Uuid
  isActive   Boolean @default(true)

  service  Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@id([serviceId, providerId])
  @@index([providerId])
  @@map("service_providers")
}

// -----------------------------------------------------------------------------
// Availability
// -----------------------------------------------------------------------------

// A weekly schedule for a provider, valid for an optional date range.
model Availability {
  id            String       @id @default(uuid()) @db.Uuid
  providerId    String       @db.Uuid
  locationId    String?      @db.Uuid
  name          String       @default("Default")
  timezone      String // IANA zone the rules are expressed in
  effectiveFrom DateTime?    @db.Date
  effectiveTo   DateTime?    @db.Date
  isDefault     Boolean      @default(false)
  status        RecordStatus @default(ACTIVE)
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)

  provider ProviderProfile    @relation(fields: [providerId], references: [id], onDelete: Cascade)
  location Location?          @relation(fields: [locationId], references: [id], onDelete: SetNull)
  rules    AvailabilityRule[]

  @@index([providerId, status])
  @@map("availabilities")
}

// One working interval on a weekday. Breaks are gaps: Mon 09:00-13:00 + 14:00-18:00.
model AvailabilityRule {
  id             String   @id @default(uuid()) @db.Uuid
  availabilityId String   @db.Uuid
  locationId     String?  @db.Uuid
  dayOfWeek      Int // ISO: 1 = Monday ... 7 = Sunday
  startMinute    Int // minutes from local midnight, 0..1439
  endMinute      Int // exclusive, 1..1440
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  availability Availability @relation(fields: [availabilityId], references: [id], onDelete: Cascade)
  location     Location?    @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@index([availabilityId, dayOfWeek])
  @@map("availability_rules")
}

// Date overrides: CUSTOM_HOURS replaces the weekly rules on those dates
// (several rows = several intervals); DAY_OFF / LEAVE / HOLIDAY remove them.
// serviceId = null applies to every service the provider offers; set it to
// scope the override to just one (a provider who offers 2+ services can
// have entirely different dates/hours per service).
model AvailabilityException {
  id          String                    @id @default(uuid()) @db.Uuid
  providerId  String                    @db.Uuid
  serviceId   String?                   @db.Uuid
  type        AvailabilityExceptionType
  startDate   DateTime                  @db.Date
  endDate     DateTime                  @db.Date
  startMinute Int?
  endMinute   Int?
  reason      String?
  createdAt   DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime                  @updatedAt @db.Timestamptz(3)

  provider ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service  Service?        @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([providerId, startDate, endDate])
  @@index([serviceId])
  @@map("availability_exceptions")
}

// Organization / location wide closures.
model Holiday {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  locationId     String?  @db.Uuid // null => all locations
  name           String
  date           DateTime @db.Date
  isRecurring    Boolean  @default(false) // same month/day every year
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location?    @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@index([organizationId, date])
  @@map("holidays")
}

// Ad-hoc absolute-time blocks (meeting, training).
model BlockedSlot {
  id          String   @id @default(uuid()) @db.Uuid
  providerId  String?  @db.Uuid // null => whole location blocked
  locationId  String?  @db.Uuid
  startsAt    DateTime @db.Timestamptz(3)
  endsAt      DateTime @db.Timestamptz(3)
  reason      String?
  createdById String?  @db.Uuid
  createdAt   DateTime @default(now()) @db.Timestamptz(3)

  provider  ProviderProfile? @relation(fields: [providerId], references: [id], onDelete: Cascade)
  location  Location?        @relation(fields: [locationId], references: [id], onDelete: Cascade)
  createdBy User?            @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([providerId, startsAt])
  @@index([locationId, startsAt])
  @@map("blocked_slots")
}

// -----------------------------------------------------------------------------
// Bookings
// -----------------------------------------------------------------------------

// The record of one submission. Keeps a snapshot of the submitted personal
// details; service-specific answers are validated by the service's Zod
// schema and stored in formData.
model Booking {
  id                  String        @id @default(uuid()) @db.Uuid
  organizationId      String        @db.Uuid
  bookingNumber       String        @unique // APT-2026-000001
  type                BookingType
  customerId          String        @db.Uuid
  source              BookingSource @default(ONLINE)
  status              BookingStatus @default(PENDING_PAYMENT)
  paymentStatus       PaymentStatus @default(PENDING)
  currency            String        @default("PKR") @db.Char(3)
  subtotal            Decimal       @db.Decimal(12, 2)
  discountAmount      Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount         Decimal       @db.Decimal(12, 2)
  amountPaid          Decimal       @default(0) @db.Decimal(12, 2)
  // submitted personal details (snapshot)
  customerFirstName   String
  customerLastName    String?
  customerEmail       String?
  customerPhone       String?
  customerDateOfBirth DateTime?     @db.Date
  customerGender      Gender?
  customerCity        String?
  customerProvince    String?
  customerAddress     String?
  // service-specific answers + the schema version that validated them
  formData            Json?
  formVersion         Int?
  termsAcceptedAt     DateTime?     @db.Timestamptz(3)
  termsUrl            String?
  customerNotes       String?
  internalNotes       String?
  idempotencyKey      String?
  createdById         String?       @db.Uuid
  confirmedAt         DateTime?     @db.Timestamptz(3)
  cancelledAt         DateTime?     @db.Timestamptz(3)
  cancelledById       String?       @db.Uuid
  cancellationReason  String?
  createdAt           DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @db.Timestamptz(3)

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer            Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy           User?                @relation("BookingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  cancelledBy         User?                @relation("BookingCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  appointments        Appointment[]
  payments            Payment[]
  invoices            Invoice[]
  financeTransactions FinanceTransaction[]
  notifications       Notification[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, type, status, createdAt])
  @@index([organizationId, paymentStatus])
  @@index([customerId, createdAt])
  @@map("bookings")
}

// The time slot of an appointment booking. Critical fields are real columns
// (provider, service, start/end, status, payment status) — never JSON.
model Appointment {
  id                     String        @id @default(uuid()) @db.Uuid
  organizationId         String        @db.Uuid
  bookingId              String        @db.Uuid
  customerId             String        @db.Uuid
  providerId             String        @db.Uuid
  serviceId              String        @db.Uuid
  packageId              String?       @db.Uuid
  locationId             String?       @db.Uuid
  // appointment date = startsAt in `timezone`; start/end time = startsAt/endsAt
  startsAt               DateTime      @db.Timestamptz(3)
  endsAt                 DateTime      @db.Timestamptz(3)
  // provider time consumed including buffers (what the exclusion constraint protects)
  blockedFrom            DateTime      @db.Timestamptz(3)
  blockedUntil           DateTime      @db.Timestamptz(3)
  timezone               String
  status                 BookingStatus @default(PENDING_PAYMENT)
  paymentStatus          PaymentStatus @default(PENDING)
  // optional: unpaid bookings are cancelled after this instant (setting)
  holdExpiresAt          DateTime?     @db.Timestamptz(3)
  price                  Decimal       @db.Decimal(12, 2)
  discountAmount         Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount            Decimal       @db.Decimal(12, 2)
  source                 BookingSource @default(ONLINE)
  availabilityOverridden Boolean       @default(false)
  rescheduledFromId      String?       @unique @db.Uuid
  confirmedAt            DateTime?     @db.Timestamptz(3)
  completedAt            DateTime?     @db.Timestamptz(3)
  cancelledAt            DateTime?     @db.Timestamptz(3)
  cancelledById          String?       @db.Uuid
  cancellationReason     String?
  // digital-ticket check-in (Phase 11): opaque per-appointment token, never the booking number,
  // encoded in the QR code the confirmation email carries
  checkInToken           String        @unique @default(uuid()) @db.Uuid
  checkedInAt            DateTime?     @db.Timestamptz(3)
  checkedInById          String?       @db.Uuid
  createdAt              DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime      @updatedAt @db.Timestamptz(3)

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  booking         Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer        Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  provider        ProviderProfile @relation(fields: [providerId], references: [id], onDelete: Restrict)
  service         Service         @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  package         ServicePackage? @relation(fields: [packageId], references: [id], onDelete: Restrict)
  location        Location?       @relation(fields: [locationId], references: [id], onDelete: SetNull)
  rescheduledFrom Appointment?    @relation("AppointmentReschedule", fields: [rescheduledFromId], references: [id], onDelete: SetNull)
  rescheduledTo   Appointment?    @relation("AppointmentReschedule")
  cancelledBy     User?           @relation("AppointmentCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)
  checkedInBy     User?           @relation("AppointmentCheckedInBy", fields: [checkedInById], references: [id], onDelete: SetNull)

  @@index([providerId, startsAt])
  @@index([customerId, startsAt])
  @@index([organizationId, status, startsAt])
  @@index([serviceId, startsAt])
  @@index([status, holdExpiresAt])
  @@map("appointments")
}

// -----------------------------------------------------------------------------
// Payments (manual verification), invoices, finance
// -----------------------------------------------------------------------------

// Created PENDING with the booking. Staff verify it after the customer sends
// proof (WhatsApp/email); the method is known only then.
model Payment {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @db.Uuid
  paymentNumber   String         @unique // PAY-2026-000001
  bookingId       String?        @db.Uuid
  invoiceId       String?        @db.Uuid
  customerId      String?        @db.Uuid
  status          PaymentStatus  @default(PENDING)
  method          PaymentMethod?
  amount          Decimal        @db.Decimal(12, 2)
  currency        String         @default("PKR") @db.Char(3)
  reference       String? // bank / wallet transaction id
  proofFileId     String?        @db.Uuid // optional screenshot uploaded by staff
  notes           String?
  submittedAt     DateTime?      @db.Timestamptz(3) // customer reported paying
  verifiedAt      DateTime?      @db.Timestamptz(3)
  verifiedById    String?        @db.Uuid
  rejectedAt      DateTime?      @db.Timestamptz(3)
  rejectedById    String?        @db.Uuid
  rejectionReason String?
  refundedAmount  Decimal        @default(0) @db.Decimal(12, 2)
  refundedAt      DateTime?      @db.Timestamptz(3)
  refundedById    String?        @db.Uuid
  refundReason    String?
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  booking             Booking?             @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  invoice             Invoice?             @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  customer            Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  proofFile           File?                @relation("PaymentProof", fields: [proofFileId], references: [id], onDelete: SetNull)
  verifiedBy          User?                @relation("PaymentVerifiedBy", fields: [verifiedById], references: [id], onDelete: SetNull)
  rejectedBy          User?                @relation("PaymentRejectedBy", fields: [rejectedById], references: [id], onDelete: SetNull)
  refundedBy          User?                @relation("PaymentRefundedBy", fields: [refundedById], references: [id], onDelete: SetNull)
  financeTransactions FinanceTransaction[]

  @@index([organizationId, status, createdAt])
  @@index([bookingId])
  @@index([invoiceId])
  @@index([customerId])
  @@map("payments")
}

model Invoice {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  invoiceNumber  String          @unique // INV-2026-000001 for CUSTOMER, PSL-2026-000001 for PROVIDER
  audience       InvoiceAudience @default(CUSTOMER)
  customerId     String?         @db.Uuid // set when audience = CUSTOMER
  providerId     String?         @db.Uuid // set when audience = PROVIDER
  bookingId      String?         @db.Uuid
  status         InvoiceStatus   @default(DRAFT)
  currency       String          @default("PKR") @db.Char(3)
  subtotal       Decimal         @db.Decimal(12, 2)
  discountAmount Decimal         @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal         @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal         @db.Decimal(12, 2)
  amountPaid     Decimal         @default(0) @db.Decimal(12, 2)
  amountDue      Decimal         @db.Decimal(12, 2)
  issueDate      DateTime        @db.Date
  dueDate        DateTime?       @db.Date
  notes          String?
  createdById    String?         @db.Uuid
  issuedAt       DateTime?       @db.Timestamptz(3)
  voidedAt       DateTime?       @db.Timestamptz(3)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer     Customer?        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  provider     ProviderProfile? @relation(fields: [providerId], references: [id], onDelete: Restrict)
  booking      Booking?         @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  createdBy    User?            @relation("InvoiceCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  items        InvoiceItem[]
  payments     Payment[]

  @@index([organizationId, status, issueDate])
  @@index([customerId])
  @@index([providerId])
  @@index([bookingId])
  @@map("invoices")
}

model InvoiceItem {
  id             String  @id @default(uuid()) @db.Uuid
  invoiceId      String  @db.Uuid
  serviceId      String? @db.Uuid
  description    String
  quantity       Decimal @default(1) @db.Decimal(10, 2)
  unitPrice      Decimal @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  taxRatePercent Decimal @default(0) @db.Decimal(5, 2)
  taxAmount      Decimal @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal @db.Decimal(12, 2)
  sortOrder      Int     @default(0)

  invoice Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([invoiceId])
  @@map("invoice_items")
}

model FinanceCategory {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  type           FinanceCategoryType
  name           String
  slug           String
  description    String?
  status         RecordStatus        @default(ACTIVE)
  createdAt      DateTime            @default(now()) @db.Timestamptz(3)

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions FinanceTransaction[]

  @@unique([organizationId, type, slug])
  @@map("finance_categories")
}

// The ledger: every verified payment, refund, paid expense and manual
// adjustment produces exactly one posted row.
model FinanceTransaction {
  id                String                   @id @default(uuid()) @db.Uuid
  organizationId    String                   @db.Uuid
  transactionNumber String                   @unique // TXN-2026-000001
  type              FinanceTransactionType
  categoryId        String?                  @db.Uuid
  amount            Decimal                  @db.Decimal(12, 2) // always positive; direction from type
  currency          String                   @default("PKR") @db.Char(3)
  paymentMethod     PaymentMethod?
  reference         String?
  bookingId         String?                  @db.Uuid
  paymentId         String?                  @db.Uuid
  expenseId         String?                  @db.Uuid
  customerId        String?                  @db.Uuid
  locationId        String?                  @db.Uuid
  status            FinanceTransactionStatus @default(POSTED)
  notes             String?
  transactionDate   DateTime                 @db.Timestamptz(3)
  createdById       String?                  @db.Uuid
  createdAt         DateTime                 @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                 @updatedAt @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  category     FinanceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  booking      Booking?         @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  payment      Payment?         @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  expense      Expense?         @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  customer     Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdBy    User?            @relation("FinanceTransactionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([organizationId, transactionDate])
  @@index([organizationId, type, status])
  @@index([bookingId])
  @@index([paymentId])
  @@map("finance_transactions")
}

model ExpenseCategory {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  name           String
  slug           String
  description    String?
  status         RecordStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenses     Expense[]

  @@unique([organizationId, slug])
  @@map("expense_categories")
}

model Expense {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  expenseNumber  String         @unique // EXP-2026-000001
  categoryId     String         @db.Uuid
  locationId     String?        @db.Uuid
  vendor         String?
  description    String
  amount         Decimal        @db.Decimal(12, 2)
  currency       String         @default("PKR") @db.Char(3)
  paymentMethod  PaymentMethod?
  reference      String?
  expenseDate    DateTime       @db.Date
  status         ExpenseStatus  @default(DRAFT)
  receiptFileId  String?        @db.Uuid
  createdById    String?        @db.Uuid
  approvedById   String?        @db.Uuid
  approvedAt     DateTime?      @db.Timestamptz(3)
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @db.Timestamptz(3)

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  category            ExpenseCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  location            Location?            @relation(fields: [locationId], references: [id], onDelete: SetNull)
  receiptFile         File?                @relation("ExpenseReceipt", fields: [receiptFileId], references: [id], onDelete: SetNull)
  createdBy           User?                @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  approvedBy          User?                @relation("ExpenseApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  financeTransactions FinanceTransaction[]

  @@index([organizationId, expenseDate])
  @@index([organizationId, status])
  @@map("expenses")
}

// -----------------------------------------------------------------------------
// Email notifications
// -----------------------------------------------------------------------------

// Editable wording per message and audience (Handlebars, restricted variables).
model EmailTemplate {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  key            EmailTemplateKey
  audience       NotificationAudience
  name           String
  subject        String
  bodyHtml       String
  isActive       Boolean              @default(true)
  updatedById    String?              @db.Uuid
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @db.Timestamptz(3)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedBy     User?          @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  notifications Notification[]

  @@unique([organizationId, key, audience])
  @@map("email_templates")
}

// Outbox + job: one message to one recipient. Written in the same
// transaction as the booking change; delivered afterwards with retries.
model Notification {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  bookingId      String?              @db.Uuid
  // Set instead of bookingId for account-level messages (e.g. STAFF_INVITE) that aren't about a booking.
  userId         String?              @db.Uuid
  // The account's admin-set/system-generated password (STAFF_INVITE only) — captured at queue time
  // (userId rows only) since, unlike booking data, it can't be re-derived at send time: the plaintext
  // is never stored anywhere else once Supabase hashes it.
  credential     String?
  templateId     String?              @db.Uuid
  templateKey    EmailTemplateKey
  audience       NotificationAudience
  channel        NotificationChannel  @default(EMAIL)
  recipientName  String?
  recipientEmail String?
  recipientPhone String?
  subject        String?
  body           String?
  dedupeKey      String?              @unique
  status         NotificationStatus   @default(QUEUED)
  scheduledFor   DateTime?            @db.Timestamptz(3)
  attempts       Int                  @default(0)
  lastError      String?
  sentAt         DateTime?            @db.Timestamptz(3)
  createdAt      DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  booking      Booking?          @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  user         User?             @relation("NotificationUser", fields: [userId], references: [id], onDelete: SetNull)
  template     EmailTemplate?    @relation(fields: [templateId], references: [id], onDelete: SetNull)
  logs         NotificationLog[]
  emailLogs    EmailLog[]

  @@index([organizationId, status, scheduledFor])
  @@index([bookingId])
  @@map("notifications")
}

// One row per delivery attempt.
model NotificationLog {
  id               String              @id @default(uuid()) @db.Uuid
  notificationId   String              @db.Uuid
  channel          NotificationChannel
  attempt          Int
  status           DeliveryStatus
  provider         String?
  providerResponse Json?
  error            String?
  createdAt        DateTime            @default(now()) @db.Timestamptz(3)

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@map("notification_logs")
}

model EmailLog {
  id                String         @id @default(uuid()) @db.Uuid
  notificationId    String?        @db.Uuid
  recipient         String
  subject           String
  template          String?
  status            DeliveryStatus
  provider          String
  providerMessageId String?
  providerResponse  Json?
  error             String?
  sentAt            DateTime?      @db.Timestamptz(3)
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)

  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)

  @@index([recipient, createdAt])
  @@index([status, createdAt])
  @@map("email_logs")
}

// -----------------------------------------------------------------------------
// Files (Supabase Storage)
// -----------------------------------------------------------------------------

model File {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  bucket         String
  path           String // object key inside the bucket
  originalName   String
  mimeType       String
  sizeBytes      Int
  checksumSha256 String?
  visibility     FileVisibility @default(PRIVATE)
  uploadedById   String?        @db.Uuid
  createdAt      DateTime       @default(now()) @db.Timestamptz(3)
  deletedAt      DateTime?      @db.Timestamptz(3)

  organization      Organization      @relation("OrganizationFiles", fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy        User?             @relation("FileUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  organizationLogos Organization[]    @relation("OrganizationLogo")
  userAvatars       User[]            @relation("UserAvatar")
  providerImages    ProviderProfile[] @relation("ProviderImage")
  paymentProofs     Payment[]         @relation("PaymentProof")
  expenseReceipts   Expense[]         @relation("ExpenseReceipt")

  @@unique([bucket, path])
  @@index([organizationId, createdAt])
  @@map("files")
}

// -----------------------------------------------------------------------------
// Audit, settings, sequences
// -----------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @db.Uuid
  userId         String?  @db.Uuid
  action         String // "booking.create", "payment.verify"
  entityType     String
  entityId       String?
  oldValues      Json?
  newValues      Json?
  ipAddress      String?
  userAgent      String?
  requestId      String?
  createdAt      DateTime @default(now()) @db.Timestamptz(3)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

model SystemSetting {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  key            String // "payment.bankName", "support.whatsapp"
  value          Json
  description    String?
  updatedById    String?  @db.Uuid
  createdAt      DateTime @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedBy    User?        @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@unique([organizationId, key])
  @@map("system_settings")
}

// Atomic per-organization, per-prefix, per-year counters for human-readable
// numbers (APT-2026-000001), incremented inside the business transaction.
model DocumentSequence {
  organizationId String   @db.Uuid
  prefix         String // APT | PAY | INV | TXN | EXP | CUS
  year           Int
  lastValue      Int      @default(0)
  updatedAt      DateTime @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, prefix, year])
  @@map("document_sequences")
}
