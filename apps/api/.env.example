# ---------------------------------------------------------------------------
# ShifaWorks booking API — copy to .env and fill in. Never commit the real .env.
# Server-only: nothing here is ever sent to the browser.
#
# Business details (support phone / email / WhatsApp, bank and wallet payment
# instructions, admin notification emails, booking rules) are NOT environment
# variables: admins set them in Admin → Settings (stored in the database).
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
# On Vercel, set to 1 so req.ip / rate limiting see the real client address behind its edge proxy.
TRUST_PROXY_HOPS=0

# Public booking app (booking.shifaworks.com) and this API.
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000

# --- Database (Supabase) ---------------------------------------------------
# Runtime: transaction pooler (Supavisor, port 6543).
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"
# Migrations / seed / studio: session or direct connection (port 5432).
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
DATABASE_POOL_MAX=10
# Local docker alternative (docker compose up -d):
# DATABASE_URL="postgresql://booking:booking@localhost:5432/booking"
# DIRECT_URL="postgresql://booking:booking@localhost:5432/booking"

# --- Supabase Auth (staff & providers only; SERVER-ONLY secrets) -----------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-or-secret-key>
SUPABASE_JWT_AUDIENCE=authenticated
# Only for projects still using the legacy HS256 JWT secret:
# SUPABASE_JWT_SECRET=

# --- Cloudinary (file/image storage — provider photos, payment proofs, -----
# expense receipts, weekly log archives). Get these from the Cloudinary
# dashboard (console.cloudinary.com) → the API Keys / account summary page.
CLOUDINARY_CLOUD_NAME=<cloud-name>
CLOUDINARY_API_KEY=<api-key>
CLOUDINARY_API_SECRET=<api-secret>
MAX_UPLOAD_MB=10
# Weekly CSV exports of old audit/email logs (uploaded to Cloudinary), before they're deleted from the hot tables.
LOG_ARCHIVE_RETENTION_DAYS=14

# --- Redis / queues (optional) ------------------------------------------------
# Without Redis the API delivers emails in-process. QUEUE_ENABLED=true moves
# email delivery and periodic jobs onto BullMQ (needs REDIS_URL).
REDIS_URL=redis://localhost:6379
QUEUE_ENABLED=false
# Set false on API instances when a separate `npm run worker` process runs the jobs,
# or when deploying to Vercel (nothing stays running between requests there —
# set RUN_WORKERS=false and CRON_SECRET below; Vercel Cron drives the periodic jobs instead).
RUN_WORKERS=true
# Required on Vercel only: authenticates Vercel Cron's calls to /internal/cron/*.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRON_SECRET=

# --- Email ------------------------------------------------------------------
# console = render + log only (development default); production defaults to disabled.
EMAIL_PROVIDER=console
EMAIL_FROM="ShifaWorks <no-reply@shifaworks.com>"
# EMAIL_REPLY_TO=support@shifaworks.com
# SMTP (EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Resend (EMAIL_PROVIDER=resend)
RESEND_API_KEY=
# Turns local numbers (0300…) into +92300…
DEFAULT_PHONE_COUNTRY_CODE=92

# --- Application -------------------------------------------------------------
DEFAULT_ORGANIZATION_SLUG=shifaworks
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_SIGNING_SECRET=<at-least-32-random-characters>

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Booking-form submissions allowed per IP per hour (spam protection).
PUBLIC_BOOKING_LIMIT_PER_HOUR=10

# --- Seed ----------------------------------------------------------------------
# The seed creates (or links) a Supabase Auth user for the super admin.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=<strong-password>
# Development only: demo providers, packages with DEMO prices, open services, a demo event.
SEED_DEMO_DATA=false
